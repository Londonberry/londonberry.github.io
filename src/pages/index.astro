---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCaseStudies } from '../lib/work';

// Proof tiles link to case studies. A tile shows only once its case study is
// approved (or in a preview build), so the home page never links to a 404.
const live = new Set((await getCaseStudies()).map((s) => s.id));
const proof = [
  { title: 'One door to the AI model', body: 'Every AI call goes through one place, with a spend cap per customer checked first.', id: 'ai-guardrails' },
  { title: 'AI proposes, a person approves', body: 'Nothing touches the books until someone at the store says yes.', id: 'invoice-hub' },
  { title: 'Holds instead of publishing', body: 'If a post fails the compliance check, it waits and we get an alert.', id: 'content-pipeline' },
  { title: 'Guardrails that fail the build', body: "If a safety rule breaks, the change doesn't ship.", id: 'ai-guardrails' },
].filter((t) => live.has(t.id));
---

<BaseLayout
  title="Home"
  description="You built the prototype with AI. Londonberry takes it to production: security, spend limits, tests, and a person in the loop. Plus the sports apps we've built."
>
  <!-- Hero -->
  <section class="bg-primary text-white">
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
      <p class="text-xs md:text-sm font-bold uppercase tracking-widest text-white/70 mb-4">Prototype to production &middot; Sports software</p>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black leading-tight mb-6">
        You built the prototype. <span class="text-white/60">We'll take it to production.</span>
      </h1>
      <p class="text-lg md:text-xl text-white/85 leading-relaxed mb-8">
        AI got you a working demo. We add the parts that keep it working: security, spend limits, tests, and a person in the loop.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="bg-white text-primary px-8 py-3 rounded-md font-bold text-sm uppercase tracking-wide hover:bg-white/90 transition-colors text-center inline-flex items-center justify-center leading-none">
          Start a Conversation
        </a>
        <a href="/services" class="border-2 border-white text-white px-8 py-3 rounded-md font-bold text-sm uppercase tracking-wide hover:bg-white/10 transition-colors text-center inline-flex items-center justify-center leading-none">
          What We Do
        </a>
      </div>
    </div>
  </section>

  {proof.length > 0 && (
    <section class="border-b border-muted/30 py-12 md:py-16">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-xs font-bold uppercase tracking-widest text-heading/60 mb-6">What production looks like</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {proof.map((t) => (
            <a href={`/work/${t.id}/`} class="group block rounded-xl border border-muted/40 p-5 hover:border-primary/60 transition-colors">
              <h3 class="font-bold text-heading group-hover:text-primary transition-colors">{t.title}</h3>
              <p class="text-sm text-body/80 mt-2 leading-relaxed">{t.body}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Services Overview -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-xs font-bold uppercase tracking-widest text-heading/60 mb-2">How We Help</h2>
      <p class="text-2xl md:text-3xl font-bold text-heading mb-12 max-w-2xl">
        From first sketch to shipped product. We move fast and build smart.
      </p>
      <div class="grid md:grid-cols-3 gap-10">
        <!-- Fractional CTO -->
        <div class="group">
          <img src="/images/service_management.png" alt="" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 mb-5" />
          <h3 class="text-lg font-bold text-heading mb-3">Fractional CTO</h3>
          <p class="text-body/80 leading-relaxed">
            A CTO's judgment without the salary. Architecture, hiring, AI tooling, and code review on retainer for pre-seed to Series A founders who need senior backup, not a full-time exec.
          </p>
          <a href="/services/fractional-cto/" class="inline-block mt-4 text-primary font-semibold text-sm hover:underline">Learn more &rarr;</a>
        </div>
        <!-- Vibe Coding Rescue -->
        <div class="group">
          <img src="/images/service_development.png" alt="" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 mb-5" />
          <h3 class="text-lg font-bold text-heading mb-3">Vibe Coding Rescue</h3>
          <p class="text-body/80 leading-relaxed">
            Built it in Lovable, Bolt, Cursor, or Claude Code? Hit the wall where every change breaks the last one? We audit, harden, and ship AI-generated MVPs into production-grade software.
          </p>
          <a href="/services/vibe-coding-rescue/" class="inline-block mt-4 text-primary font-semibold text-sm hover:underline">Learn more &rarr;</a>
        </div>
        <!-- Code Audit -->
        <div class="group">
          <img src="/images/service_development.png" alt="" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 mb-5" />
          <h3 class="text-lg font-bold text-heading mb-3">Code Audit &amp; Security Review</h3>
          <p class="text-body/80 leading-relaxed">
            A senior read of your codebase for security holes, reliability risks, and structural debt. Prioritized findings and a fix plan, built for fast-moving teams and AI-generated code.
          </p>
          <a href="/services/code-audit/" class="inline-block mt-4 text-primary font-semibold text-sm hover:underline">Learn more &rarr;</a>
        </div>
        <!-- Rapid Prototyping -->
        <div class="group">
          <img src="/images/service_development.png" alt="" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 mb-5" />
          <h3 class="text-lg font-bold text-heading mb-3">Rapid Prototyping</h3>
          <p class="text-body/80 leading-relaxed">
            Go from idea to interactive prototype in days, not months. We use AI-assisted development to build, test, and iterate at a pace that keeps you ahead of the market.
          </p>
          <a href="/services#rapid-prototyping" class="inline-block mt-4 text-primary font-semibold text-sm hover:underline">Learn more &rarr;</a>
        </div>
        <!-- AI Strategy -->
        <div class="group">
          <img src="/images/service_management.png" alt="" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 mb-5" />
          <h3 class="text-lg font-bold text-heading mb-3">AI Strategy & Consulting</h3>
          <p class="text-body/80 leading-relaxed">
            Not sure where AI fits in your business? We help you cut through the noise, identify real opportunities, and build an AI roadmap that actually delivers value.
          </p>
          <a href="/services#ai-strategy" class="inline-block mt-4 text-primary font-semibold text-sm hover:underline">Learn more &rarr;</a>
        </div>
        <!-- Product Management -->
        <div class="group">
          <img src="/images/service_ui.png" alt="" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 mb-5" />
          <h3 class="text-lg font-bold text-heading mb-3">Product Management</h3>
          <p class="text-body/80 leading-relaxed">
            Strategic product thinking that connects your vision to what users actually need. We help define, prioritize, and ship the right features, not just more features.
          </p>
          <a href="/services#product-management" class="inline-block mt-4 text-primary font-semibold text-sm hover:underline">Learn more &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sports Tech Callout -->
  <section class="bg-heading text-white py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div>
        <h2 class="text-xs font-bold uppercase tracking-widest text-accent mb-2">Sports apps we've built</h2>
        <p class="text-2xl md:text-4xl font-bold leading-tight mb-6">
          Software for coaches, clubs, and fans.
        </p>
        <p class="text-lg text-white/80 leading-relaxed mb-8">
          Scouting reports high school coaches reorder. A platform that runs a travel ball club. Video for teams and leagues.
        </p>
        <a href="/work/#sports" class="bg-white text-heading px-8 py-3 rounded-md font-bold text-sm uppercase tracking-wide hover:bg-white/90 transition-colors inline-block">
          See the sports work
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-heading mb-4">Ready to build something?</h2>
      <p class="text-lg text-body/70 mb-8 max-w-xl mx-auto">
        Whether you have a napkin sketch or a full product spec, we'll help you move fast.
      </p>
      <a href="/contact" class="bg-primary text-white px-8 py-3 rounded-md font-bold text-sm uppercase tracking-wide hover:bg-primary/90 transition-colors inline-block">
        Get In Touch
      </a>
    </div>
  </section>
</BaseLayout>
