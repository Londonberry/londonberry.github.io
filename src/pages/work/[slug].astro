---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getCaseStudies, isPreview } from '../../lib/work';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const d = study.data;

const trackLabel = d.track === 'sports' ? 'Sports app' : 'Prototype to production';
const cta = d.track === 'sports'
  ? { title: 'Running a sports program?', body: 'We build and automate the software coaches and clubs run on.', href: '/work/#sports', label: 'See our sports work' }
  : { title: 'Got a prototype that needs to hold up?', body: "Send us the repo. We'll tell you what it needs before real users find out.", href: '/services/vibe-coding-rescue/', label: 'How we do it' };
const canonicalURL = new URL(`/work/${study.id}/`, Astro.site).href;

const caseStudyLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: d.headline,
      description: d.summary,
      about: { '@type': 'Organization', name: d.client },
      author: { '@type': 'Organization', name: 'Londonberry' },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      ...(d.image ? { image: new URL(d.image, Astro.site).href } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://londonberry.com/' },
        { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://londonberry.com/work/' },
        { '@type': 'ListItem', position: 3, name: d.headline, item: canonicalURL },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${d.headline} | ${d.client}`}
  description={d.summary}
  ogImage={d.image}
  canonicalURL={canonicalURL}
  ogType="article"
  jsonLd={caseStudyLd}
>
  {isPreview && !d.approved && (
    <div class="bg-accent text-dark text-sm font-semibold text-center py-2 px-4">
      Draft for Ben's review. Not live.
    </div>
  )}

  <section class="bg-primary text-white py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6">
      <a href="/work/" class="text-white/60 text-sm font-semibold uppercase tracking-wide hover:text-white transition-colors">&larr; All work</a>
      <p class="mt-6 text-white/80 text-sm font-semibold uppercase tracking-wide">{trackLabel} &middot; {d.client}</p>
      <h1 class="text-3xl md:text-5xl font-black leading-tight mt-3">{d.headline}</h1>
      <p class="mt-5 text-lg md:text-xl text-white/90">{d.summary}</p>
    </div>
  </section>

  {d.image && (
    <section class="pt-12">
      <div class="max-w-6xl mx-auto px-6">
        <img
          src={d.image}
          alt={d.imageAlt ?? ''}
          class="w-full h-auto rounded-xl border border-muted/40 shadow-sm"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>
  )}

  <article class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-[1fr_16rem]">
      <div class="blog-content text-lg">
        <Content />
      </div>
      <aside class="space-y-8 text-sm">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-heading/60 mb-2">Client</h2>
          {d.clientUrl ? (
            <a href={d.clientUrl} class="font-semibold text-body hover:text-primary" rel="noopener">{d.client}</a>
          ) : (
            <p class="font-semibold text-body">{d.client}</p>
          )}
        </div>
        {d.stack.length > 0 && (
          <div>
            <h2 class="text-xs font-bold uppercase tracking-widest text-heading/60 mb-2">Built with</h2>
            <ul class="flex flex-wrap gap-2">
              {d.stack.map((s) => (
                <li class="bg-muted/20 text-body px-2.5 py-1 rounded-full text-xs font-medium">{s}</li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>

  <section class="bg-heading text-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-black">{cta.title}</h2>
      <p class="mt-3 text-white/85 text-lg">{cta.body}</p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href={cta.href} class="bg-white text-heading font-bold px-6 py-3 rounded-lg hover:bg-white/90 transition-colors">{cta.label}</a>
        <a href="/contact/" class="border border-white/60 text-white font-bold px-6 py-3 rounded-lg hover:bg-white/10 transition-colors">Start a conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>
